# Which adapter to use: anthropic | gemini | ollama | sarvam
LLM_PROVIDER=ollama

# Key for the selected provider (ollama needs none)
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# SARVAM_API_KEY=...

# Optional overrides — defaults are per-provider
# LLM_MODEL=deepseekv4-flash
# LLM_MAX_TOKENS=16000
# OLLAMA_BASE_URL=http://localhost:11434
# SARVAM_BASE_URL=https://api.sarvam.ai
